{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "big-fat-fish-pet",
  "version": "0.1.0",
  "identifier": "com.bigfatfish.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "蓝色大肥鱼",
        "width": 462,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "big-fat-fish-pet",
    "copyright": "Copyright (c) 2026 big-fat-fish-pet contributors",
    "shortDescription": "蓝色大肥鱼桌面宠物",
    "longDescription": "常驻桌面的蓝色大肥鱼桌面宠物（Q版蓝发女仆），透明无边框置顶，可拖拽、点击回应、屏幕漫游。",
    "category": "Utility",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
